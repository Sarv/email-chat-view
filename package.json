{
  "name": "@sarv-in/email-chat-view",
  "version": "0.0.1",
  "description": "Turn an email thread into a chat-style conversation view. Provider-rule-driven quote/signature/disclaimer stripping plus a React chat UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarv/email-chat-view.git"
  },
  "homepage": "https://github.com/Sarv/email-chat-view#readme",
  "bugs": {
    "url": "https://github.com/Sarv/email-chat-view/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./transform": {
      "import": {
        "types": "./dist/transform.d.ts",
        "default": "./dist/transform.js"
      },
      "require": {
        "types": "./dist/transform.d.cts",
        "default": "./dist/transform.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 56",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run type-check && pnpm run test:coverage",
    "clean": "rm -rf dist",
    "media": "pnpm run build && node scripts/media/render.mjs && node scripts/media/actions.mjs",
    "media:render": "pnpm run build && node scripts/media/render.mjs",
    "media:actions": "pnpm run build && node scripts/media/actions.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "email",
    "chat",
    "thread",
    "quote-stripping",
    "signature",
    "reply-parser",
    "react",
    "imap",
    "mail"
  ],
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "chrono-node": "^2.10.0",
    "dompurify": "^3.4.12",
    "email-addresses": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^14.2.1",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.0",
    "globals": "^17.12.0",
    "jsdom": "^24.0.0",
    "linkedom": "^0.18.5",
    "prettier": "^3",
    "pretty-bytes": "^7.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8",
    "vitest": "^1.2.0"
  }
}
